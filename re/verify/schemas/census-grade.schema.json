{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "verify/schemas/census-grade.schema.json",
 "title": "census-grade result (VERIFICATION-PROGRAM.md 4.2)",
 "type": "object",
 "additionalProperties": false,
 "required": ["unit_id", "verdict", "payload", "reason"],
 "properties": {
  "unit_id": {"type": "string", "pattern": "^census-grade-0x[0-9a-f]{5,8}$"},
  "verdict": {"type": "string", "enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
  "payload": {
   "type": "object",
   "additionalProperties": false,
   "required": ["match", "observed", "note"],
   "properties": {
    "match": {"type": "boolean"},
    "observed": {"type": "string",
                 "enum": ["per_frame", "per_substep", "per_event", "init_only", "never", "menu_only", "irregular"]},
    "note": {"type": "string", "maxLength": 600}
   }
  },
  "reason": {"type": "string", "minLength": 1, "maxLength": 600},
  "meta": {"type": "object", "description": "written by worker.py or make_units.py (script grades); never by the model"}
 }
}
