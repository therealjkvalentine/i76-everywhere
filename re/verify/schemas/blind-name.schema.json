{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "verify/schemas/blind-name.schema.json",
 "title": "blind-name result (VERIFICATION-PROGRAM.md 4.5)",
 "type": "object",
 "additionalProperties": false,
 "required": ["unit_id", "verdict", "payload", "reason"],
 "properties": {
  "unit_id": {"type": "string", "pattern": "^blind-name-0x[0-9a-f]{5,8}$"},
  "verdict": {"type": "string", "enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
  "payload": {
   "type": "object",
   "additionalProperties": false,
   "required": ["name", "contract", "confidence"],
   "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*_[A-Za-z][A-Za-z0-9]*$", "maxLength": 64},
    "contract": {"type": "string", "minLength": 1, "maxLength": 500},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
   }
  },
  "reason": {"type": "string", "minLength": 1, "maxLength": 600},
  "meta": {"type": "object", "description": "written by worker.py after validation; never by the model"}
 }
}
