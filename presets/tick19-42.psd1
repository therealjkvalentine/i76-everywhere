# promotion-19 candidate 2026-10-21 (lab builds\promotion-19-candidate-20261021, README.md there; i76-everywhere docs\records\TICK-FINISH-2026-10-18.md s.19 / s.20): the tick-range preset + the rc-draw terrain set (RC-DRAW-FPS-2026-10-20: 1800 m view, x96 split out, LOD_B 4 + HYST 20 + FREEZE 300,40) + the polish switches I76_SIGN_SOUND_RESTART / I76_FADE_NO_FLIP (MENU-SOUND-POLISH-2026-10-20). Needs STRLKUP.DLL 8f8da929 (i76-everywhere 491f8db music-fix, built from HEAD 5a7f83b).
# 24 ticks/s = 1000/24 ms (I76_SIM_TICK_MS 41.667): the 1997 car step. At this tick the per-frame counters (hazard, scrape, wreck roll, radar, missile turn, flame, the slope-follow speed loss) run at their 1997 rate as they are: every tick factor is exactly 1 and is not installed, so the per-frame counters need no correction (TICK-FINISH s.14, s.18, s.20; the proxy logs 'slope-follow loss x 1.000 ... 0/3 sites').
# tick19-42 (lab, tick-range 2026-10-20, I76_SIM_TICK_MS 41.667; tick19-33 with that one key, Name and Summary changed; i76-everywhere docs\records\TICK-FINISH-2026-10-18.md): promotion 18's best-wide-balanced (PLAY-balanced.bat)
# minus every per-frame timing switch, plus the whole-sim tick at 41.667 ms with the early tick on input. Generated by lab
# tools\tick-finish\make-presets.ps1 from the daily driver's file (md5 0bca8b31a6a36a1a0ee63a226d192f74). Needs the proxy STRLKUP-tick19 (i76-everywhere
# music-fix with simtick.c); an older proxy ignores I76_SIM_TICK_MS and would run with NO fixed step and NO interpolation.
# best-wide-balanced (2026-10-05): best-wide with the far clip at 1200 m instead of 1800 m, launched by PLAY-balanced.bat as an
# EXTRA option (PLAY.bat stays best-wide). Per-switch cost on t04 open desert (lab autotest\runs\twin-sync-20261005\COST.md):
# in the cockpit no switch costs anything measurable (120 fps paced, CPU ~8.7 ms/frame, GPU 3D ~33 % in every condition);
# only the binoculars run below 120, and there the far clip is the one switch with a clear effect (terrain vertices 15.8k
# -> 4.3k, 79 -> 99 fps). Halving terrain LOD / terrain tex / object LOD / road tex / shadows / clutter changed nothing
# beyond run-to-run spread, so they stay at best-wide's values.
# best-wide: the 2026-10-03 daily-driver candidate. best-120 + the exp-detail-8 set + I76_ASPECT (Hor+ widescreen).
# Needs the widescreen dgVoodoo conf (dgVoodoo.wide.conf: [Glide] Resolution 6880x2880 + 4x, ScalingMode stretched_ar = 2x supersampled, 2026-10-12);
# the daily driver's PLAY.bat copies it in before launching. I76_ASPECT is this panel's shape (3440x1440); for another
# display set it to that display's width x height (tools\Make-Wide-Conf.ps1 writes both the conf and this file's
# values for one game folder; setup-windows.ps1 -Preset best-wide runs it). Since 2026-10-12 the 640x480 menus, garage and movies
# are shown 4:3 with side bars (stretched_ar), not stretched sideways.
@{
    Name        = 'tick19-42'
    Summary     = 'Whole-sim tick 41.667 ms (1 x 41.667 ms car step, 24 ticks/s; the 1997 car-step coupling: the stock 20 fps loop on Windows 10 averages 41.7 ms steps, Gold P133 lowest 41.0, developer default 41.5 per substep (TWO-CLOCKS-2026-10-19); TICK-FINISH s.19) + early tick on a key press; otherwise best-wide-balanced (PLAY-balanced.bat) (promotion 18)'
    Verified    = '[lab 2026-10-18] tick-finish lane, see TICK-FINISH-2026-10-18.md; NOT promoted'
    Env         = @{
        I76_HIRES_CLOCK     = '1'
        I76_MUSIC_RETAIL    = '1'   # the owner's music ruling (OWNER-TEST-LIST item 49, test 05 PASS): retail 1.0 music rules ...
        I76_MUSIC_RESUME    = '1'   # ... except resume: the music continues where it stopped (Replay, shell entry)
        I76_COOP_AI         = '1'   # LAN (as PLAY-LAN.bat): the host runs the mission cars and mirrors them to joiners; computer cars in the 15 stock arenas (AI-MELEE-RESPAWN-2026-10-20; ai_hs*.lvl out); inert in single player (32a5b04)
        I76_COOP_CHAIN      = '1'   # LAN: co-op scene won -> the next scene for everybody; joiners respawn; a lost scenario reloads
        I76_MP_MENU         = '1'   # LAN: MULTI MELEE HOST / JOIN go straight to IPX (IPXWrapper DLLs beside i76.exe)
        I76_SIM_TICK_MS     = '41.667'   # 41.667 = 1000/24 ms = 24 ticks/s, the 1997 car step: the per-frame counters need no correction; whole sim (controls, collisions, cars, AI / scripts, weapons) once per tick, drawn interpolated at the display rate
        I76_SIM_TICK_INPUT  = '1'   # a key press runs the next tick at once (borrowed from the next one: same tick length, same rate)
        # removed (per-frame timing, replaced by the tick): I76_FIXED_STEP, I76_FRAMERATE_FIXES, I76_ENGINE_DT_FIX, I76_RENDER_INTERP, I76_INPUT_LATCH, I76_AI_BACKAWAY_GRID, I76_COLL_DEDUPE, I76_COLL_WINDOW, I76_COLL_WINDOW_WHEN, I76_AI_ROLL_HOLD
        I76_FIX_HEALTH_PCT  = '1'
        I76_FIX_LABEL_TABLE = '1'
        I76_FAR_CLIP        = '1800'   # rc-draw 2026-10-20 (was '1200'): 1800 m as PLAY.bat (best-wide): the barn and the map edge from the T05 hill top (1200 came from the balanced base)
        I76_ROAD_DIST       = '1800'   # rc-draw 2026-10-20 (was '1200'): roads to the far clip, as PLAY.bat
        I76_CAM_GROUND_FIX  = '1'   # terrain kept when the eye dips under the ground (stock skips ALL terrain that frame = the terrain-to-sky flash; lab RENDER-FREEZE-2026-10-04.md s.9)
        I76_TERRAIN_HULL_FIX = '1'   # the near ground no longer vanishes for a frame in cockpit view (footprint hull rebuilt; lab TERRAIN-DROPOUT-HILL-2026-10-12.md s.10-11)
        I76_ZGLIDE_TMUFIX   = '1'   # needs dgVoodoo [Glide] MemorySizeOfTMU 8192 (promotion 12): no ZGLIDE flush freezes, no 2 MB boundary rewind (lab RENDER-FREEZE-2026-10-04.md; gate + soak 2026-10-04)
        I76_GLIDE_REFRESH   = '120'
        I76_ASPECT          = '3440x1440'
        I76_CURSOR_MAP      = '1'     # the proxy maps the menu pointer through the window (dgVoodoo.wide.conf CaptureMouse = false)
        I76_CURSOR_MAP_U32X = 'exe'   # ... taking i76.exe's u32x slots; i76shell keeps u32x (its arrow in the garage / reminder OK popups)
        I76_U32X_SHELL_STRETCH = '1'  # u32x maps the shell where dgVoodoo draws it: 4:3 fit under stretched_ar (dgVoodoo.wide.conf since 2026-10-12), whole client under stretched
        I76_CURSOR_MAP_DGV  = 'aw'    # the driver's wide (16:10) menu with the pointer on the pencil: dgVoodoo's cursor slots and u32x's shell map follow dgVoodoo.wide.conf dccd379a's picture (proxy 1ca6ba0+, CURSOR-FIX-ON-18 s.6; PLAY-TICK*.bat copy dgVoodoo.wide.conf)
        I76_U32X_MENU_ASPECT = '3440:1440'   # the mouse DLL maps the in-mission Esc menu to the full panel (verified: Exit answers where drawn)
        I76_TERRAIN_LOD     = '24'   # terrain detail split distance x24 (was x8; the split distance grows with the square root: x24 = about 1.7 x x8): distant mounds and ridges keep their shape; the vertex guard stops splits past 28,000 vertices a frame
        I76_TERRAIN_LOD_B   = '4'   # rc-draw 2026-10-20 (was '24'): height-error threshold 6x larger than LOD 24 (fewer splits): split / merge events -34 % on the T05 route
        I76_TERRAIN_TEX     = '8'
        I76_OBJECT_LOD      = '8'
        I76_SHADOW_DIST     = '4'
        I76_ROAD_TEX        = '8'
        I76_CLUTTER_DIST    = '1800'   # rc-draw 2026-10-20 (was '1200'): bushes to the far clip, as PLAY.bat
        I76_CLUTTER_FADE    = '300'   # ... at full density to 300 m like before, then thinned as (300 / d)^2 per bush (owner 2026-10-17 chose this dense variant, TEST-next-dense, over fade 200); with terrain x24 the T05 hill-top view costs the same as the fade-200 / x32 variant, lab DRAW-DISTANCE-2026-10-12.md
        I76_MIRROR_FAR      = '300'   # rear-view mirror sees 300 m instead of 100 m
        # no data yet (2026-10-03: the ram test could not stage its rams; no AI car entered the roll behaviour):
        # count only, behave as played on 2026-10-02
        I76_TERRAIN_FREEZE  = '300,40'   # rc-draw 2026-10-20: terrain beyond 300 m keeps its first shape until it comes within 300 m: change beyond 300 m 605 -> ~1 px/s
        I76_TERRAIN_HYST    = '20'   # rc-draw 2026-10-20: a split node merges 20 % farther than it split: no flip-flop around a threshold (events -24 %)
        I76_BREAKABLE_BOX   = '4'   # bar as a box (=1) + sign posts fall at the first ram, when the drawn car reaches them (sign-post sweep + render-interp timing; lab SIGN-FIX-3-2026-10-12.md)
        I76_SIGN_SOUND_RESTART = '1'   # a new sign / barricade hit stops the vnvco3 still playing on the car and starts it again (proxy polish.c; MENU-SOUND-POLISH-2026-10-20 item C)
        I76_FADE_NO_FLIP    = '1'   # the palette fade on leaving a mission / the game presents nothing under Glide: no two-frame flicker (polish.c; item B)
    }
}
