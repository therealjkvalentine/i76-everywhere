diff --git a/lfbprof.cpp b/lfbprof.cpp
new file mode 100644
index 0000000..f9b955d
--- /dev/null
+++ b/lfbprof.cpp
@@ -0,0 +1,75 @@
+//**************************************************************
+//* LFB lock/unlock profiler (OpenGLide-HD, i76-everywhere). See lfbprof.h.
+//**************************************************************
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "lfbprof.h"
+
+int LfbProfOn = -1;
+
+static FILE    *s_log;
+static double   s_freq;
+static double   s_acc[ LP_COUNT ];
+static unsigned s_locksWO, s_locksRO, s_frames, s_every = 100;
+static double   s_px, s_rows;
+static double   s_lastFrame, s_frameAcc, s_frameMax;
+
+void LfbProfInit( void )
+{
+    if ( LfbProfOn >= 0 ) return;
+    LfbProfOn = 0;
+    const char *v = getenv( "OGL_LFB_PROF" );
+    if ( !v || !*v || !strcmp( v, "0" ) ) return;
+    const char *n = getenv( "OGL_LFB_PROF_N" );
+    if ( n && atoi( n ) > 0 ) s_every = (unsigned)atoi( n );
+    s_log = fopen( strcmp( v, "1" ) ? v : "OpenGLid-lfb.log", "a" );
+    if ( !s_log ) return;
+    LARGE_INTEGER f; QueryPerformanceFrequency( &f );
+    s_freq = (double)f.QuadPart / 1000.0;
+    fprintf( s_log, "# OpenGLide LFB profile, per-frame averages over %u swaps (ms; px/rows per frame)\n"
+                    "# frames frame_ms frame_max_ms locksWO locksRO lock_flush_ms lockWO_ms lockRO_ms "
+                    "unlock_scan_ms unlock_draw_ms lfb_total_ms swap_ms written_px upload_rows\n", s_every );
+    fflush( s_log );
+    LfbProfOn = 1;
+}
+
+double LfbProfNow( void )
+{
+    LARGE_INTEGER c; QueryPerformanceCounter( &c );
+    return (double)c.QuadPart / s_freq;
+}
+
+void LfbProfAdd( int slot, double ms ) { s_acc[ slot ] += ms; }
+
+void LfbProfCount( int wo, int ro, unsigned px, unsigned rows )
+{
+    s_locksWO += wo; s_locksRO += ro; s_px += px; s_rows += rows;
+}
+
+void LfbProfFrame( void )
+{
+    double now = LfbProfNow( );
+    if ( s_lastFrame > 0 )
+    {
+        double d = now - s_lastFrame;
+        s_frameAcc += d;
+        if ( d > s_frameMax ) s_frameMax = d;
+        s_frames++;
+    }
+    s_lastFrame = now;
+    if ( s_frames < s_every ) return;
+
+    double f = (double)s_frames;
+    double lfb = s_acc[ LP_LOCK_WO ] + s_acc[ LP_LOCK_RO ] + s_acc[ LP_UNLOCK_SCAN ] + s_acc[ LP_UNLOCK_DRAW ];
+    fprintf( s_log, "%u %.3f %.3f %.2f %.2f %.3f %.3f %.3f %.3f %.3f %.3f %.3f %.0f %.0f\n",
+             s_frames, s_frameAcc / f, s_frameMax, s_locksWO / f, s_locksRO / f,
+             s_acc[ LP_LOCK_FLUSH ] / f, s_acc[ LP_LOCK_WO ] / f, s_acc[ LP_LOCK_RO ] / f,
+             s_acc[ LP_UNLOCK_SCAN ] / f, s_acc[ LP_UNLOCK_DRAW ] / f, lfb / f,
+             s_acc[ LP_SWAP ] / f, s_px / f, s_rows / f );
+    fflush( s_log );
+    memset( s_acc, 0, sizeof( s_acc ) );
+    s_locksWO = s_locksRO = s_frames = 0;
+    s_px = s_rows = s_frameAcc = s_frameMax = 0;
+}
diff --git a/lfbprof.h b/lfbprof.h
new file mode 100644
index 0000000..1c677e9
--- /dev/null
+++ b/lfbprof.h
@@ -0,0 +1,30 @@
+//**************************************************************
+//* LFB lock/unlock profiler (OpenGLide-HD, i76-everywhere).
+//* Off unless the environment variable OGL_LFB_PROF is set:
+//*   OGL_LFB_PROF=1          -> log to OpenGLid-lfb.log in the CWD
+//*   OGL_LFB_PROF=<path>     -> log to <path>
+//* One line per OGL_LFB_PROF_N swaps (default 100), all times CPU-side
+//* wall clock (QueryPerformanceCounter), per-frame averages in ms.
+//**************************************************************
+#ifndef LFBPROF_H
+#define LFBPROF_H
+
+enum LfbProfSlot
+{
+    LP_LOCK_FLUSH = 0,  // RenderDrawTriangles() inside grLfbLock (3D work, not LFB)
+    LP_LOCK_WO,         // rest of grLfbLock, write-only locks
+    LP_LOCK_RO,         // rest of grLfbLock, read locks (glReadPixels + convert)
+    LP_UNLOCK_SCAN,     // grLfbUnlock write: colour-key scan + 565->8888
+    LP_UNLOCK_DRAW,     // grLfbUnlock write: glTexSubImage2D + quad
+    LP_SWAP,            // grBufferSwap (flush + SwapBuffers)
+    LP_COUNT
+};
+
+extern int  LfbProfOn;
+void        LfbProfInit( void );
+double      LfbProfNow( void );                 // ms
+void        LfbProfAdd( int slot, double ms );
+void        LfbProfCount( int locksWO, int locksRO, unsigned writtenPx, unsigned uploadRows );
+void        LfbProfFrame( void );               // call once per grBufferSwap, after the swap
+
+#endif
-- 
