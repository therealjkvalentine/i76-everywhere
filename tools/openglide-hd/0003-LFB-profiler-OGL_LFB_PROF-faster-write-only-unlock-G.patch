diff --git a/build-mingw.sh b/build-mingw.sh
new file mode 100644
index 0000000..fdff152
--- /dev/null
+++ b/build-mingw.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+# Build OpenGLide(-HD) glide2x.dll, 32-bit, with a mingw-w64 i686 g++.
+#   macOS (Homebrew):  brew install mingw-w64 && CXX=i686-w64-mingw32-g++ sh build-mingw.sh
+#   Linux:             apt install g++-mingw-w64-i686 && CXX=i686-w64-mingw32-g++ sh build-mingw.sh
+#   Windows:           w64devkit x86 (its g++ is i686): sh build-mingw.sh
+# Output: glide2x.dll (OUT=... to rename). Needs only Wine/Windows system DLLs at run time.
+set -e
+cd "$(dirname "$0")"
+CXX="${CXX:-g++}"
+OUT="${OUT:-glide2x.dll}"
+SRC="grguDepth.cpp grguMisc.cpp grgu3df.cpp grguDraw.cpp grguSstGlide.cpp grguFog.cpp grguTex.cpp
+grguLfb.cpp GLRender.cpp OGLFogTables.cpp OGLTextureTables.cpp OGLColorAlphaTables.cpp TexDB.cpp
+PGUTexture.cpp Glide.cpp GLExtensions.cpp PGTexture.cpp FormatConversion.cpp grguBuffer.cpp
+grguColorAlpha.cpp GLutil.cpp gsplash.cpp"
+for f in hdtexture.cpp lfbprof.cpp; do [ -f "$f" ] && SRC="$SRC $f"; done
+SRC="$SRC $(ls platform/windows/*.cpp)"
+"$CXX" -shared -o "$OUT" -O2 -fpermissive -w -std=gnu++14 -I. -Iplatform/windows $SRC Glide2x.def \
+    -static -static-libgcc -static-libstdc++ -lopengl32 -lglu32 -lgdi32 -luser32 -lwinmm
+echo "built $OUT ($(wc -c < "$OUT") bytes)"
diff --git a/build-msvc.ps1 b/build-msvc.ps1
new file mode 100644
index 0000000..a7a63cd
--- /dev/null
+++ b/build-msvc.ps1
@@ -0,0 +1,31 @@
+# Build OpenGLide(-HD) glide2x.dll, 32-bit, with the Visual Studio 2019 C++ x86 build tools
+# (the same toolchain music-fix\build-msvc.ps1 and u32x\build-full.ps1 use). Static CRT (/MT).
+# Usage: powershell -ExecutionPolicy Bypass -File build-msvc.ps1
+$ErrorActionPreference = 'Stop'
+Set-Location $PSScriptRoot
+$vcvars = $null
+foreach ($root in @("${env:ProgramFiles(x86)}\Microsoft Visual Studio", "$env:ProgramFiles\Microsoft Visual Studio")) {
+    if (-not (Test-Path $root)) { continue }
+    $f = Get-ChildItem $root -Recurse -Filter 'vcvars32.bat' -ErrorAction SilentlyContinue | Select-Object -First 1
+    if ($f) { $vcvars = $f.FullName; break }
+}
+if (-not $vcvars) { Write-Host 'vcvars32.bat not found' -ForegroundColor Red; exit 1 }
+
+$src = @(
+    'grguDepth.cpp','grguMisc.cpp','grgu3df.cpp','grguDraw.cpp','grguSstGlide.cpp',
+    'grguFog.cpp','grguTex.cpp','grguLfb.cpp','GLRender.cpp','OGLFogTables.cpp',
+    'OGLTextureTables.cpp','OGLColorAlphaTables.cpp','TexDB.cpp','PGUTexture.cpp',
+    'Glide.cpp','GLExtensions.cpp','PGTexture.cpp','FormatConversion.cpp',
+    'grguBuffer.cpp','grguColorAlpha.cpp','GLutil.cpp','gsplash.cpp'
+)
+if (Test-Path hdtexture.cpp) { $src += 'hdtexture.cpp' }
+if (Test-Path lfbprof.cpp)   { $src += 'lfbprof.cpp' }
+$src += (Get-ChildItem platform\windows\*.cpp | ForEach-Object { "platform\windows\$($_.Name)" })
+
+New-Item -ItemType Directory -Force obj | Out-Null
+$cl   = "cl /nologo /c /O2 /MT /EHsc /W0 /D_CRT_SECURE_NO_WARNINGS /DWIN32 /D_WINDOWS /DCPPDLL /DNDEBUG /I. /Iplatform\windows /Ikhr-include /Foobj\ " + ($src -join ' ')
+$link = 'link /nologo /DLL /OUT:glide2x.dll obj\*.obj opengl32.lib glu32.lib gdi32.lib user32.lib winmm.lib advapi32.lib'
+cmd /c "call `"$vcvars`" >nul && $cl && $link"
+if ($LASTEXITCODE -eq 0) {
+    Write-Host "built glide2x.dll ($([math]::Round((Get-Item glide2x.dll).Length/1KB)) KB, x86, MSVC)"
+} else { Write-Host 'build failed' -ForegroundColor Red; exit 1 }
