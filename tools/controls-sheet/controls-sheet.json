  "stock_only_actions": {
    "_readme": "Actions GOG's 1997 map binds and controls/input.map does not. Only used on the comparison page. Empty since 2026-10-03, when hardpoint1_fire was bound (1 and J)."
  },

  "fixed_keys": {
    "_readme": "Keys the engine handles outside input.map. They cannot be read from the map, so they are listed here with their source.",
    "F1":  {"group": "views",   "label": "Cockpit view",                "key": "Cockpit", "source": "i76-remap.ahk, '@pad Y' and '@pad LB+Y' comment lines"},
    "F3":  {"group": "views",   "label": "Chase camera",                "key": "Chase",   "source": "i76-remap.ahk, '@pad Y' comment line"},
    "F2":  {"group": "views",   "label": "Other camera view",           "key": "View",    "source": "i76-remap.ahk, '@pad LB+Y' comment line (cycle F1 F2 F3 F7 F8 F9 F10)"},
    "F7":  {"group": "views",   "label": "Other camera view",           "key": "View",    "source": "same"},
    "F8":  {"group": "views",   "label": "Other camera view",           "key": "View",    "source": "same"},
    "F9":  {"group": "views",   "label": "Other camera view",           "key": "View",    "source": "same"},
    "F10": {"group": "views",   "label": "Other camera view",           "key": "View",    "source": "same"},
    "Esc": {"group": "systems", "label": "Pause menu / skip cutscene",  "key": "Menu / skip", "source": "i76-remap.ahk, '@pad Select' comment line"}
  },

  "allow_shared_keys": {
    "_readme": "Sets of actions that are MEANT to sit on one key (the game uses them in different screens or views: since 2026-10-07 the arrows glance in the cockpit and orbit the external camera). Any other two actions on one key fail the build.",
    "sets": [
      ["track_pitch_minus", "overview_z_minus", "pilot_glance_up"],
      ["track_pitch_plus", "overview_z_plus", "pilot_glance_down"],
      ["track_yaw_minus", "overview_x_minus", "pilot_glance_left"],
      ["track_yaw_plus", "overview_x_plus", "pilot_glance_right"],
      ["track_distance_minus", "overview_zoom_minus", "zoom_factor_minus"],
      ["track_distance_plus", "overview_zoom_plus", "zoom_factor_plus"]
    ]
  },

  "mouse": {
    "_readme": "Left / right / middle come from the map. Buttons 4 and 5 are parsed from i76-remap.ahk (XButton1 / XButton2). The wheel keys are parsed from PLAY-i76.ps1's -WheelUp / -WheelDown defaults. expect = the action each is meant to perform; the build fails if the key sent is bound to something else.",
    "XButton1":  {"name": "Button 4 (back)",    "expect": "special1"},
    "XButton2":  {"name": "Button 5 (forward)", "expect": "hardpoint3_fire"},
    "WheelUp":   {"name": "Wheel up",           "expect": "weapon_cycle"},
    "WheelDown": {"name": "Wheel down",         "expect": "hardpoint5_fire"}
  },

  "gamepad": {
    "_readme": "The pad layer (XIPoll in i76-remap.ahk) is code, not a table, so its bindings are listed here by hand. source: i76-remap.ahk, the '@pad' comment lines and the XIPoll section, read 2026-10-03. The build cross-checks every entry: 'at' must be an existing @pad line and every @pad line must be used; a key named in brackets on the @pad line must be in 'sends'; the union of all 'sends' must equal the set of keys the XIPoll code actually sends; and each key must be bound in the map to 'expect'.",
    "source": "i76-remap.ahk @pad lines + XIPoll code",
    "native": {
      "_readme": "From the map: the only native pad bindings are the two analog axes.",
      "LS": "Left stick"
    },
    "entries": [
      {"control": "RT", "layer": "base",  "at": "RT",                "sends": ["LButton"],          "expect": ["weapon_fire"],       "how": "hold"},
      {"control": "RT", "layer": "base",  "at": "RT(looking back)",  "sends": ["3"],                "expect": ["hardpoint3_fire"],   "how": "while the right stick is held back (rear view)"},
      {"control": "LT", "layer": "base",  "at": "LT",                "sends": ["2"],                "expect": ["hardpoint2_fire"],   "how": "hold"},
      {"control": "LB", "layer": "base",  "at": "LB(tap)",           "sends": ["q"],                "expect": ["frontal_target"],    "how": "tap; hold = SHIFT"},
      {"control": "RB", "layer": "base",  "at": "RB",                "sends": ["Space"],            "expect": ["e_brake"],           "how": "hold"},
      {"control": "A",  "layer": "base",  "at": "A(tap)",            "sends": ["LButton", "Enter"], "expect": ["weapon_fire", "weapon_fire"], "how": "tap; types a click and Enter: OK in menus, one shot in the car"},
      {"control": "A",  "layer": "base",  "at": "A(hold 400ms)",     "sends": ["6"],                "expect": ["special1"],          "how": "hold 0.4 s"},
      {"control": "B",  "layer": "base",  "at": "B(tap)",            "sends": ["Tab"],               "expect": ["weapon_cycle"],      "how": "tap"},
      {"control": "X",  "layer": "base",  "at": "X",                 "sends": ["y"],                "expect": ["next_target"],       "how": ""},
      {"control": "Y",  "layer": "base",  "at": "Y",                 "sends": ["F3", "F1"],         "expect": [null, null],          "how": "alternates"},
      {"control": "Back",  "layer": "base", "at": "Select",          "sends": ["Esc"],              "expect": [null],                "how": ""},
      {"control": "Start", "layer": "base", "at": "Start",           "sends": ["m"],                "expect": ["show_map"],          "how": ""},
      {"control": "D-pad up",    "layer": "base", "at": "Dpad-Up",    "sends": ["h"],               "expect": ["toggle_lights"],     "how": ""},
      {"control": "D-pad down",  "layer": "base", "at": "Dpad-Down",  "sends": ["i"],               "expect": ["start_engine"],      "how": ""},
      {"control": "D-pad left",  "layer": "base", "at": "Dpad-Left",  "sends": ["n"],               "expect": ["show_notepad"],      "how": ""},
      {"control": "D-pad right", "layer": "base", "at": "Dpad-Right", "sends": ["m"],               "expect": ["show_map"],          "how": ""},
      {"control": "RS", "layer": "base",  "at": "RStick",            "sends": ["Up", "Down", "Left", "Right"], "expect": ["pilot_glance_up", "pilot_glance_down", "pilot_glance_left", "pilot_glance_right"], "how": "held while deflected", "label": "Look around"},
      {"control": "R3", "layer": "base",  "at": "R3",                "sends": ["e"],                "expect": ["pilot_glance_target"], "how": ""},
      {"control": "R3", "layer": "base",  "at": "R3(looking back)",  "sends": ["4"],                "expect": ["hardpoint4_fire"],   "how": "while the right stick is held back"},
      {"control": "L3", "layer": "base",  "at": "L3",                "sends": ["6"],                "expect": ["special1"],          "how": "hold"},
      {"control": "L3", "layer": "base",  "at": "L3",                "sends": ["x"],                "expect": ["reverse_direction"], "how": "pressed with the left stick pulled back"},
      {"control": "RT", "layer": "shift", "at": "LB+RT",             "sends": ["1"],                "expect": ["hardpoint1_fire"],   "how": "hold"},
      {"control": "LT", "layer": "shift", "at": "LB+LT",             "sends": ["5", "2"],           "expect": ["hardpoint5_fire", "hardpoint2_fire"], "how": "hold"},
      {"control": "A",  "layer": "shift", "at": "LB+A",              "sends": ["3"],                "expect": ["hardpoint3_fire"],   "how": "hold"},
      {"control": "B",  "layer": "shift", "at": "LB+B",              "sends": ["4"],                "expect": ["hardpoint4_fire"],   "how": "hold"},
      {"control": "X",  "layer": "shift", "at": "LB+X",              "sends": ["r"],                "expect": ["radar_range_toggle"], "how": ""},
      {"control": "Y",  "layer": "shift", "at": "LB+Y",              "sends": ["F1", "F2", "F3", "F7", "F8", "F9", "F10"], "expect": [null, null, null, null, null, null, null], "how": "one step per press", "label": "Cycle camera views"},
      {"control": "D-pad up",    "layer": "shift", "at": "LB+Dpad-Up",    "sends": ["b"],           "expect": ["toggle_binoculars"], "how": ""},
      {"control": "D-pad down",  "layer": "shift", "at": "LB+Dpad-Down",  "sends": ["g"],           "expect": ["honk_horn"],         "how": "hold"},
      {"control": "D-pad left",  "layer": "shift", "at": "LB+Dpad-Left",  "sends": [","],           "expect": ["shift_down"],        "how": ""},
      {"control": "D-pad right", "layer": "shift", "at": "LB+Dpad-Right", "sends": ["."],           "expect": ["shift_up"],          "how": ""}
    ],
    "unbound_controls": {
      "_readme": "Pad controls with no @pad line and no native binding in the map. Empty since 2026-10-03 (RB = handbrake)."
    }
  },

