  "known_mismatches": {
    "_readme": "Real inconsistencies between the owner's map and the layers, found by the checker and listed instead of fixed. Empty since 2026-10-03: the owner ruled that the four pad mismatches found that day be fixed in the pad layer (gears on , and ., B types Tab, 1 bound to hardpoint 1). Each id is '<layer>:<control>:<key sent>'. The build fails on a mismatch that is not listed here, and on an entry here that is no longer a mismatch.",
    "list": []
  },

