# Gold app: HKCU\Environment of the prefix = the family Gold apps' engine switches (MacBook, 2026-10-25), minus TEMP/TMP
# (Wine writes its own) and OGL_VIEWPORT (the launcher computes it from the display at every start). Graphics tier keys
# are added by --graphics (payload/graphics/*.env).
I76_AI_ROLL_HOLD=0
I76_COLL_DEDUPE=0
I76_COOP_AI=1
I76_COOP_CHAIN=1
I76_ENGINE_DT_FIX=1
I76_FIX_HEALTH_PCT=1
I76_FIX_LABEL_TABLE=1
I76_FIXED_STEP=24
I76_FPS_CAP=120
I76_FPS_LOG=5
I76_FRAMERATE_FIXES=1
I76_HIRES_CLOCK=1
I76_MUSIC_THREAD=1
I76_RENDER_INTERP=1
I76MUSIC_LOG=1
OGL_GAMMA=1.3
OGL_MSAA=4
OGL_OUTPUT=parent
