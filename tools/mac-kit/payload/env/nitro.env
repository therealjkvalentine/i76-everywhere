# Nitro app: HKCU\Environment = the family Nitro apps' switches (MacBook, 2026-10-25; docs/records/NITRO-MAC-2026-10-21.md s.1),
# minus TEMP/TMP and OGL_VIEWPORT (computed by the launcher). Frame policy since 2026-10-25 (docs/records/NITRO-MAC-UNCAP-2026-10-25.md):
# the whole-sim tick at 41.667 ms as PC main Nitro runs it, under the Mac Gold apps' 120 fps cap (was a 24 fps cap).
I76_CAM_GROUND_FIX=1
I76_FIX_HEALTH_PCT=1
I76_FIX_LABEL_TABLE=1
I76_FPS_CAP=120
I76_FPS_LOG=5
I76_HIRES_CLOCK=1
I76_MUSIC_RESUME=1
I76_MUSIC_RETAIL=1
I76_MUSIC_THREAD=1
I76_SIM_TICK_INPUT=1
I76_SIM_TICK_MS=41.667
I76_TERRAIN_HULL_FIX=1
I76_ZGLIDE_TMUFIX=1
I76MUSIC_LOG=1
OGL_GAMMA=1.3
OGL_MSAA=4
OGL_OUTPUT=parent
